# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL=

# PostgreSQL Database Connection (Split Credentials)
PGHOST=
PGPORT=5432
PGDATABASE=postgres
PGUSER=
PGPASSWORD=
# Set PGSSLMODE=disable if connecting to a local/Docker PostgreSQL without TLS
# PGSSLMODE=disable

# RustFS S3-Compatible Object Storage
RUSTFS_ENDPOINT=
RUSTFS_REGION=us-east-1
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
RUSTFS_BUCKET=docuzilla-dataroom

# OpenAI-Compatible AI Assistant API
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Session Signing Secret (min 16 random chars in production)
SESSION_SECRET=
